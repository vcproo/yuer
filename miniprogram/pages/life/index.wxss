.page{padding:30rpx 38rpx 50rpx}.brand{font-size:38rpx;border-bottom:1rpx solid #e2e5d9;padding-bottom:24rpx}.settings{float:right;font-size:23rpx;color:#889475;padding-top:10rpx}.eyebrow{font-size:19rpx;letter-spacing:3rpx;color:#929b80;margin-top:28rpx}.heading{font-size:44rpx;margin:15rpx 0}.subtitle,.body{font-size:24rpx;color:#89947c;line-height:1.9}.chapters{white-space:nowrap;margin:26rpx 0}.chapter{display:inline-block;color:#a0a78f;font-size:23rpx;padding:16rpx 0;margin-right:30rpx}.active{color:#5e784b!important;border-bottom:3rpx solid #7c9465}.scene{position:relative;border-radius:32rpx;background:#eef0e5;overflow:hidden}.canvas{width:100%;height:480rpx}.pill{position:absolute;top:25rpx;left:28rpx;font-size:22rpx;color:#82916f;background:#fffdf2c9;padding:9rpx 16rpx;border-radius:25rpx}.age{position:absolute;bottom:26rpx;left:28rpx;font-size:35rpx}.event{padding:12rpx 0 25rpx}.title{font-size:37rpx;margin:22rpx 0}.body{margin-bottom:26rpx}.option{background:#fffdf8;border:1rpx solid #e2e5d7;border-radius:20rpx;text-align:left;display:flex;justify-content:space-between;gap:18rpx;font-size:24rpx;line-height:1.6;padding:23rpx;margin-bottom:16rpx;color:#526348}.option[disabled]{color:#9ba48d;opacity:.7}.option.selected{background:#eaf0df;border-color:#92a77c;opacity:1}.price{color:#a88760;white-space:nowrap}.result{background:#eaf0df;color:#71865a;font-size:22rpx;padding:20rpx;border-radius:15rpx;line-height:1.8}.next{background:#697f56;color:#fffef5;border:0;font-size:25rpx;padding:12rpx;border-radius:18rpx;margin:20rpx 0}.next[disabled]{background:#d6ddcb;color:#a0ab93}.note{font-size:21rpx;color:#a0a78e;line-height:1.8}.money{background:#fffdf8;border:1rpx solid #e4e6d9;border-radius:28rpx;padding:33rpx;margin:15rpx 0}.total{font-size:60rpx;margin:16rpx 0 28rpx}.row{display:flex;justify-content:space-between;font-size:24rpx;color:#80906e;margin:23rpx 0}.rule{height:1rpx;background:#e6e8db;margin:30rpx 0}.over,.error{color:#b98267}.tabs{display:flex;gap:40